#!/usr/bin/env bash
# Stand-in for hyprctl in the effects.sh tests. Logs every call to
# $HYPRCTL_LOG, reports the options in $HYPRCTL_UNSUPPORTED (space-separated)
# as missing, and fails reloads when $HYPRCTL_FAIL_RELOAD is set. `monitors -j`
# prints $HYPRCTL_MONITORS, by default a 165 Hz laptop screen, at the rate a
# rule in the toggle file sets, unless $HYPRCTL_REFUSE_MODE is set.

echo "$*" >>"$HYPRCTL_LOG"
case $1 in
getoption)
    if [[ " ${HYPRCTL_UNSUPPORTED:-} " == *" $2 "* ]]; then
        echo "no such option"
    else
        echo "bool: true"
    fi
    ;;
monitors)
    json=${HYPRCTL_MONITORS:-}
    if [[ -z $json ]]; then
        json=$(
            cat <<'JSON'
[{"name": "eDP-1", "width": 2560, "height": 1600, "refreshRate": 165.00400, "mirrorOf": "none",
  "availableModes": ["2560x1600@165.00Hz", "2560x1600@120.00Hz", "2560x1600@60.00Hz",
    "2560x1600@48.00Hz", "1920x1200@30.00Hz"]}]
JSON
        )
    fi
    # The rate a rule in the toggle file sets, unless the panel refuses it.
    rule=$(sed -n 's/.*mode = "[0-9]*x[0-9]*@\([0-9.]*\)".*/\1/p' \
        "$HOME/.local/state/omarchy/toggles/hypr/power-saver.lua" 2>/dev/null)
    if [[ -n $rule && -z ${HYPRCTL_REFUSE_MODE:-} ]]; then
        json=$(jq --argjson rate "$rule" 'map(if .name == "eDP-1" then .refreshRate = $rate end)' <<<"$json")
    fi
    echo "$json"
    ;;
reload)
    if [[ -n ${HYPRCTL_FAIL_RELOAD:-} ]]; then
        echo "reload refused" >&2
        exit 1
    fi
    echo "ok"
    ;;
esac
